<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="001-create-device-cache" author="anshu">
        <createTable tableName="device_cache" schemaName="image">


            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="uuid" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="device_name" type="VARCHAR(100)"/>
            <column name="device_type" type="VARCHAR(50)"/>
            <column name="status" type="VARCHAR(20)"/>

            <column name="device_secret" type="VARCHAR(100)"/>

            <column name="last_synced_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

    </changeSet>

</databaseChangeLog>
