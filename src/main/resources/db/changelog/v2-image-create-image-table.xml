<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="002-create-image-table" author="anshu">

        <createTable tableName="image" schemaName="image">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="uuid" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="device_uuid" type="UUID">
                <constraints nullable="false"/>
            </column>

            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>

            <column name="captured_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <!-- FK: image → device_cache (UUID based) -->
        <addForeignKeyConstraint
                constraintName="fk_image_device"
                baseTableSchemaName="image"
                baseTableName="image"
                baseColumnNames="device_uuid"
                referencedTableSchemaName="image"
                referencedTableName="device_cache"
                referencedColumnNames="uuid"/>

        <!-- Index for date + time queries -->
        <createIndex indexName="idx_image_device_time"
                     schemaName="image"
                     tableName="image">
            <column name="device_uuid"/>
            <column name="captured_at"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
